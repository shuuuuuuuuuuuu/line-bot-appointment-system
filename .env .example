# --- Database Configuration ---
DB_NAME=line_bot_db
DB_USER=root
DB_ROOT_PASSWORD=your_mysql_root_password
DB_HOST=db

# --- Line Bot Settings ---
# Get these from Line Developers Console
CHANNEL_SECRET=your_channel_secret_here
CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# --- Google Calendar API ---
# Path to credentials.json (ensure this file is in .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=app/credentials.json

# --- Email Service (Gmail SMTP) ---
MAIL_USERNAME=your_gmail_account@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=your_gmail_account@gmail.com
MAIL_SERVER=smtp.gmail.com

# --- Security & Authentication ---
# You can generate a secret using: openssl rand -hex 32
JWT_SECRET=your_random_jwt_secret_here

# Optional: used only when creating the first admin account
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change-me-now

# --- Frontend & Integration ---
# Your ngrok or production domain (e.g., https://your-app.com)
BASE_URL=your_domain
VITE_LIFF_ID=your_liff_id_here
# LIFF frontend API base (often the same ngrok URL as BASE_URL)
VITE_API_URL=http://localhost:8000
# Admin UI API base (defaults to http://localhost:8000 in docker-compose)
VITE_ADMIN_API_URL=http://localhost:8000

# --- Infrastructure ---
REDIS_HOST=redis
